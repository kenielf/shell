# vi: ft=sh
# Author
AUTHOR="kenielf"

# Exit Codes
_KSCFG_SUCCESS=0
_KSCFG_ERROR=1
_KSCFG_INVALID_USAGE=2

# Logging Functions
## Simple print alias
## print <message:str>
alias print="printf -- '%s\n'"

## Write custom message to stdout (should not be used outside of init)
## _msg <prefix:str> <message:str>
_msg() {
    if [ -z "${1}" ] || [ -z "${2}" ]; then
        return "${_KSCFG_INVALID_USAGE}"
    fi

    printf -- "%b %b\n" "${1}" "${2}"
}

## Log level aliases
## <level> <message:str>
alias   _debug="[ \"\${KSCFG_DEBUG=1}\" = 1 ] && _msg '\x1b[35m[DEBUG]\x1b[00m'"
alias    _info="_msg '\x1b[34m[INFO]\x1b[00m'"
alias    _warn="_msg '\x1b[33m[WARN]\x1b[00m'"
alias _success="_msg '\x1b[32m[SUCCESS]\x1b[00m'"
alias   _error="_msg '\x1b[31m[ERROR]\x1b[00m'"

# Global State
export _KSCFG_LOADED=0

# Module Functions
export _KSCFG_MODULE_DIR="${KSCFG_DIR}/config"
export _KSCFG_MODULES_LOADED=""
_KSCFG_SHELL="$(echo "${SHELL}" | awk -F '/' '{print $NF}')"
export _KSCFG_SHELL

## Exports a function to be used externally
## _export_function <function:callable>
_export_function() {
    if [ -z "${1}" ]; then
        _error "export_function: missing 'function' argument"
        return "${_KSCFG_INVALID_USAGE}"
    fi

    if [ "${_KSCFG_SHELL}" = "bash" ]; then
        export -f "${1?}"
    fi
}

## Helper function that shows command usage for kscfg
_kscfg_help() {
    print "kscfg: by ${AUTHOR}"
    print "  -s | setup)    sets up the environment"
    print "  -l | list)     lists loaded modules"
    print "  -r | reload)   reload the environment"
}

_kscfg_load() {
    if [ "${_KSCFG_LOADED}" = 1 ]; then
        return "${_KSCFG_SUCCESS}"
    fi

    # Load the base modules
    for module in "${_KSCFG_MODULE_DIR}"/{base,core}/*; do
        # shellcheck source=/dev/null
        . "${module}"
        module_name="${module#"${_KSCFG_MODULE_DIR}"##}"
        if [ -z "${_KSCFG_MODULES_LOADED}" ]; then
            _KSCFG_MODULES_LOADED="${module_name}"
        else
            _KSCFG_MODULES_LOADED="${_KSCFG_MODULES_LOADED} ${module_name}"
        fi
    done

    # Load the extra modules
}

## The main kscfg command
kscfg() {
    if [ -z "${1}" ]; then
        _error "kscfg: missing 'action' argument"
        return "${_KSCFG_INVALID_USAGE}"
    fi

    case "${1}" in
        "-s" | "setup")
            _kscfg_load
            if [ "${KSCFG_DEBUG}" ]; then
                _kscfg_dependency_print
            fi
            _kscfg_dependency_check
            _kscfg_autostart_run
            ;;
        "-l" | "list")
            for module in ${_KSCFG_MODULES_LOADED}; do
                print "${module}"
            done
            ;;
        "-r" | "reload")
            # shellcheck source=/dev/null
            source "${HOME}/.${_KSCFG_SHELL}rc"
            ;;
        "-u" | "update")
            git -C "${KSCFG_DIR}" remote update >/dev/null 2>&1
            changes="$(git -C "${KSCFG_DIR}" status -uno)"
            if [ -n "${changes}" ]; then
                git -C "${KSCFG_DIR}" pull | \
                    grep --color=never -P '^Updating' 2>/dev/null && \
                    kscfg reload || return "${_KSCFG_ERROR}"
            fi
            ;;
        "-h" | "help")
            _kscfg_help
            ;;
        *)
            _error "kscfg: invalid 'action' argument"
            _kscfg_help
            return "${_KSCFG_INVALID_USAGE}"
    esac
}
