# vi: ft=sh
# Author
AUTHOR="kenielf"

# Exit Codes
_KSCFG_SUCCESS=0
_KSCFG_ERROR=1
_KSCFG_INVALID_USAGE=2

# Logging Functions
## Simple print alias
## print <message:str>
alias print="printf -- '%s\n'"

## Write custom message to stdout (should not be used outside of init)
## _msg <prefix:str> <message:str>
_msg() {
    if [ -z "${1}" ] || [ -z "${2}" ]; then
        return "${_KSCFG_INVALID_USAGE}"
    fi

    printf -- "%b %b\n" "${1}" "${2}"
}

## Log level aliases
## <level> <message:str>
alias   _debug="[ \"\${_KSCFG_DEBUG=1}\" = 1] && _msg '\x1b[35m[DEBUG]'"
alias    _info="_msg '\x1b[34m[INFO]\x1b[00m'"
alias    _warn="_msg '\x1b[33m[WARN]\x1b[00m'"
alias _success="_msg '\x1b[32m[SUCCESS]\x1b[00m'"
alias   _error="_msg '\x1b[31m[ERROR]\x1b[00m'"

# Module Functions
_KSCFG_MODULE_DIR="${KSCFG_DIR}/config"
_KSCFG_MODULES_LOADED=""
_KSCFG_SHELL="$(echo "${SHELL}" | awk -F '/' '{print $NF}')"

## Exports a function to be used externally
## _export_function <function:callable>
_export_function() {
    if [ -z "${1}" ]; then
        _error "export_function: missing 'function' argument"
        return "${_KSCFG_INVALID_USAGE}"
    fi

    if [ "${_KSCFG_SHELL}" = "bash" ]; then
        export -f "${1?}"
    fi
}

## The main kscfg command
kscfg() {
    if [ -z "${1}" ]; then
        _error "kscfg: missing 'action' argument"
        return "${_KSCFG_INVALID_USAGE}"
    fi

    case "${1}" in
        "setup")
            for module in "${_KSCFG_MODULE_DIR}"/{base,core}/*; do
                # shellcheck source=/dev/null
                . "${module}"
                if [ -z "${_KSCFG_MODULES_LOADED}" ]; then
                    _KSCFG_MODULES_LOADED="${module}"
                else
                    _KSCFG_MODULES_LOADED="${_KSCFG_MODULES_LOADED} ${module}"
                fi
            done
            _debug "kscfg: todo: implement"
            ;;
        "list")
            for module in ${_KSCFG_MODULES_LOADED}; do
                print "${module}"
            done
            ;;
        "help" | *)
            print "kscfg: by ${AUTHOR}"
            ;;
    esac
}
