# vi: ft=sh
# shellcheck shell=sh
# Author
AUTHOR="kenielf"

# Exit Codes
export _KSCFG_SUCCESS=0
export _KSCFG_ERROR=1
export _KSCFG_INVALID_USAGE=2
export _KSCFG_UNIMPLEMENTED=3

# String Functions
## A dedicated function to append text with a space separator
_append() {
    # Separator
    if [ "${3}" ]; then
        separator="${3}"
    else
        separator=" "
    fi

    if [ -z "${1}" ]; then
        printf -- "%s" "${2}"
    else
        printf -- "%s%s%s" "${1}" "${separator}" "${2}"
    fi
}

# TODO: Make these string functions POSIX compliant

## Joins a space separated string with commas (for printing)
_join() {
    if [ -z "${1}" ]; then
        _error "string: missing string to be joined"
        return 1
    fi

    echo "${1/ /, }"
}

## Sorts and joins a space separated string with comas (for printing)
_join_sorted() {
    if [ -z "${1}" ]; then
        _error "string: missing string to be joined"
        return 1
    fi
    echo "${1}" | sort | sed 's/ /, /g'
}

## Checks if a string is a number
_is_number() {
    if [ -z "${1}" ]; then
        _error "string: missing string to verify as number"
        return 1
    fi

    if ! (echo "${1}" | grep -P '^[0-9]+$' >/dev/null 2>&1); then
        return 0
    fi
}

# Logging Functions
## Simple print alias
## print <message:str>
alias print="printf -- '%s\n'"

## Write custom message to stdout (should not be used outside of init)
## _msg <prefix:str> <message:str>
_msg() {
    if [ -z "${1}" ] || [ -z "${2}" ]; then
        return "${_KSCFG_INVALID_USAGE}"
    fi

    printf -- "%b %b\n" "${1}" "${2}"
}

## Log level aliases
## <level> <message:str>
alias   _debug="[ \"\${KSCFG_DEBUG=1}\" = 1 ] && _msg '\x1b[35m[DEBUG]\x1b[00m'"
alias    _info="_msg '\x1b[34m[INFO]\x1b[00m'"
alias    _warn="_msg '\x1b[33m[WARN]\x1b[00m'"
alias _success="_msg '\x1b[32m[SUCCESS]\x1b[00m'"
alias   _error="_msg '\x1b[31m[ERROR]\x1b[00m'"

## Allows for commands to be partially implemented
todo() {
    if [ "${#}" -lt 1 ]; then
        _error "todo: missing arguments"
        return "${_KSCFG_INVALID_USAGE}"
    fi

    _msg "\x1b[36mTODO:\x1b[00m ${*}"
    return "${_KSCFG_UNIMPLEMENTED}"
}

# Global State
export _KSCFG_LOADED=0

# Module Functions
export _KSCFG_MODULE_DIR="${KSCFG_DIR}/config"
export _KSCFG_MODULES_LOADED=""
export _KSCFG_MODULE_PATTERNS="core/.*"
_KSCFG_SHELL="$(echo "${SHELL}" | awk -F '/' '{print $NF}')"
export _KSCFG_SHELL

## Exports a function to be used externally
## _export_function <function:callable>
_export_function() {
    if [ -z "${1}" ]; then
        _error "export_function: missing 'function' argument"
        return "${_KSCFG_INVALID_USAGE}"
    fi

    if [ "${_KSCFG_SHELL}" = "bash" ]; then
        # shellcheck disable=SC3045
        export -f "${1?}"
    fi
}

## Helper function that shows command usage for kscfg
_kscfg_help() {
    print "kscfg: by ${AUTHOR}"
    printf "  %s\t%s\t%b\n" "-e" "enable" "Enables a module by a non extended regex pattern."
    printf "  %s\t%s\t%b\n" "-h" "help" "Shows command usage."
    printf "  %s\t%s\t%b\n" "-l" "list" "Lists currently enabled modules."
    printf "  %s\t%s\t%b\n" "-r" "reload" "Reloads the current configuration"
    printf "  %s\t%s\t%b\n" "-s" "setup" "Runs the initial setup (should only be executed once)."
    printf "  %s\t%s\t%b\n" "-u" "update" "Performs a self update if necessary."
}

_kscfg_load_module() {
    if [ -z "${1}" ]; then return "${_KSCFG_INVALID_USAGE}"; fi

    # If the module is a file, check for the pattern match and load it if it does.
    if [ -f "${1}" ]; then
        module="${1##"${_KSCFG_MODULE_DIR}/"}"  # trim path prefix
        module="${module%%.sh}"  # Trim extension suffix
        _debug "kscfg: module is '${module}'"

        # Since expr is limited in terms of pattern matching, the pattern is 
        # checked iteratively from a space separated string
        for pattern in ${_KSCFG_MODULE_PATTERNS}; do
            _debug "kscfg: pattern to check is '${pattern}'"
            if expr "${module}" : "${pattern}" >/dev/null 2>&1; then
                # shellcheck source=/dev/null
                . "${1}"

                _KSCFG_MODULES_LOADED="$(_append "${_KSCFG_MODULES_LOADED}" "${module}")"
                _debug "kscfg: module '${module}' loaded."
                break
            fi
        done
    # if the module is a directory, load it recursively
    elif [ -d "${1}" ]; then
        for item in "${1}"/*; do
            _kscfg_load_module "${item}" &
        done
    fi
}

_kscfg_load_all() {
    if [ "${_KSCFG_LOADED}" = 1 ]; then
        return "${_KSCFG_SUCCESS}"
    fi

    # Load all modules
    _kscfg_load_module "${_KSCFG_MODULE_DIR}"
}

_kscfg_reload() {
    # shellcheck source=/dev/null
    . "${HOME}/.${_KSCFG_SHELL}rc"
}

## The main kscfg command
kscfg() {
    if [ -z "${1}" ]; then
        _error "kscfg: missing 'action' argument"
        return "${_KSCFG_INVALID_USAGE}"
    fi

    case "${1}" in
        "-e" | "enable")
            if [ -z "${2}" ]; then
                _error "kscfg: missing 'module' argument!"
                return "${_KSCFG_INVALID_USAGE}"
            fi

            shift
            if [ "${_KSCFG_LOADED}" = 1 ]; then
                _info "enable: to-do!"
            fi

            for arg in "$@"; do
                _KSCFG_MODULE_PATTERNS="$(
                    _append "${_KSCFG_MODULE_PATTERNS}" "${arg}"
                )"
                _debug "kscfg: pattern = '${_KSCFG_MODULE_PATTERNS}'"
            done
            ;;
        "-s" | "setup")
            _kscfg_load_all
            if [ "${KSCFG_DEBUG}" ]; then
                _kscfg_dependency_print
            fi
            _kscfg_dependency_check
            _kscfg_autostart_run
            export _KSCFG_LOADED=1
            ;;
        "-l" | "list")
            for module in ${_KSCFG_MODULES_LOADED}; do
                print "${module}"
            done
            ;;
        "-r" | "reload")
            _kscfg_reload
            ;;
        "-u" | "update")
            _kscfg_git() { git -C "${KSCFG_DIR}" "$@"; }

            old="$(_kscfg_git rev-parse --short=8 HEAD)"
            _kscfg_git fetch --quiet
            upstream="$(_kscfg_git rev-parse --abbrev-ref --symbolic-full-name '@{u}')"

            if [ "$(_kscfg_git rev-list --count "HEAD..$upstream")" -ne 0 ]; then
                _kscfg_git pull --ff-only --quiet || return "${_KSCFG_ERROR}"
                new="$(_kscfg_git rev-parse --short=8 HEAD)"
                msg="$(_kscfg_git log -1 --format=%s HEAD)"

                _success "Updated ${old}..${new}: ${msg}"
            fi

            _kscfg_reload
            ;;
        "-h" | "help")
            _kscfg_help
            ;;
        *)
            _error "kscfg: invalid 'action' argument"
            _kscfg_help
            return "${_KSCFG_INVALID_USAGE}"
    esac
}
